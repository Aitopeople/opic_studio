# Required in production: at least 32 random bytes. Never commit actual secrets.
AUTH_SECRET=
APP_MODE=local
APP_URL=http://localhost:3000
# Local development can use official dynamic registration, on 127.0.0.1:3000.
# A remotely hosted service must receive ChatGPT plan-usage approval and client credentials.
CHATGPT_ISSUER=https://auth.openai.com
CHATGPT_CLIENT_ID=
CHATGPT_CLIENT_SECRET=
# Set false to disable local dynamic registration.
CHATGPT_LOCAL_AUTH=true
# Account-specific model discovery is used; never falls back to an operator API key.
OPENAI_MODEL=gpt-6-luna
OPENAI_REASONING_EFFORT=medium
# Optional speech transcription only; billed separately from ChatGPT plan usage.
# Used only when you explicitly choose GPT transcription after completing an exam.
OPENAI_TRANSCRIBE_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# Use a persistent volume in production. SQLite supports one app host.
DATA_DIR=.data
# Guests are available only for the loopback-only local runtime.
DEMO_MODE=true
